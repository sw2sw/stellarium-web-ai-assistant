 })
 
-const loc = 'en'
-// Un-comment to select user's language automatically
-// loc = (navigator.language || navigator.userLanguage).split('-')[0] || 'en'
+// Host UI language. Deliberately NOT derived from navigator.language or the OS:
+// this deployment is a teaching site whose host language is owned by the
+// assistant panel (task book 5.1), so it must be the same on every machine.
+// Order: ?lang= in the URL, then the remembered choice, then Chinese.
+const SUPPORTED_LOCALES = Object.keys(messages)
+function resolveLocale () {
+  const fromQuery = new URLSearchParams(window.location.search).get('lang')
+  if (fromQuery && SUPPORTED_LOCALES.indexOf(fromQuery) !== -1) {
+    return fromQuery
+  }
+  try {
+    const saved = window.localStorage.getItem('swe.uiLang')
+    if (saved && SUPPORTED_LOCALES.indexOf(saved) !== -1) return saved
+  } catch (e) {}
+  return SUPPORTED_LOCALES.indexOf('zh') !== -1 ? 'zh' : 'en'
+}
+const loc = resolveLocale()
 Moment.locale(loc)
 var i18n = new VueI18n({
   locale: loc,
@@ -90,6 +104,17 @@ var i18n = new VueI18n({
   silentTranslationWarn: true
 })
 
+// The assistant panel drives the host language through this hook, so switching
+// language does not reload the page and does not reset time/location/selection.
+// Returns false for an unsupported locale instead of silently falling back.
+window.__SWE_SET_LANG__ = function (target) {
+  if (!target || messages[target] === undefined) return false
+  i18n.locale = target
+  Moment.locale(target)
+  try { window.localStorage.setItem('swe.uiLang', target) } catch (e) {}
+  return true
+}
