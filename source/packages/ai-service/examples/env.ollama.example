# 服务器 AI：本机 Ollama，无 Key
#
# 适用：离线机房、内网演示、不想把密钥放上服务器的场合。
# 特征：authMode=none —— 服务端从不发送 Authorization 头。
#
# 用法：
#   set -a; . ./env.ollama.example; set +a
#   node packages/ai-service/server.mjs
#
# 然后在管理页（http://127.0.0.1:8080/admin）填：
#   Base URL   http://127.0.0.1:11434/v1
#   模型       qwen2.5:7b
#   认证方式   none — 从不发送 Authorization
#   保存 → 检查连接（不生成）→ 需要时再点"生成测试"（会占一次额度）

# --- 监听 ---------------------------------------------------------------
SWE_BIND=127.0.0.1
SWE_PORT=8080
SWE_STATIC_DIR=../packages/integrated-web/dist
SWE_DATA_DIR=/var/lib/swe-ai

# 对外地址。反代部署时填真实 origin，否则留空按请求自身的 origin 判断。
# SWE_PUBLIC_ORIGIN=https://sky.example.edu.cn

# 只有这些地址发来的 X-Forwarded-* 会被采信。直连时留空。
# SWE_TRUSTED_PROXY=127.0.0.1

# --- 上游白名单 ---------------------------------------------------------
# 空 = 谁都不能配（失败关闭）。这里只放行本机 Ollama 的端口。
# 规则：精确 host、host:port、一级 *.example.com。云元数据地址一律拒绝，写进来也没用。
SWE_AI_ALLOWED_HOSTS=127.0.0.1:11434

# --- 口令 ---------------------------------------------------------------
# 课堂口令：老师用它在面板里登录，才能走付费路由。可以逗号分隔多个。
SWE_ACCESS_TOKENS=class-demo-1,class-demo-2
# 管理口令：只给运维/教研负责人。能改配置、看额度、紧急停用。
SWE_ADMIN_TOKENS=admin-demo-change-me

# 生产环境建议改用文件，撤权不用重启（按 mtime 重读）：
# SWE_ACCESS_TOKENS_FILE=/etc/swe-ai/class.tokens
# SWE_ADMIN_TOKENS_FILE=/etc/swe-ai/admin.tokens

# --- 其它 ---------------------------------------------------------------
# 0 表示允许匿名（仅限完全隔离的内网演示）。默认 1。
SWE_REQUIRE_AUTH=1
# auto 优先用 node:sqlite，不可用时回退 JSON 台账。也可以强制 sqlite / json。
SWE_STORE_BACKEND=auto
SWE_LOG_LEVEL=info
