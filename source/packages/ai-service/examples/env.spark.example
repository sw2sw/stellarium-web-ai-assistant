# 服务器 AI：Spark（有 Key）
#
# 适用：学校已购买讯飞星火（Spark）的 OpenAI 兼容接口。
# 特征：authMode=auto —— 存了 Key 就发 `Authorization: Bearer <Key>`，没存就不发。
#
# 与 Ollama 的差别只有三处：
#   1. Base URL 是厂商的 HTTPS 域名，不是本机回环地址；
#   2. 必须存 Key（存进 0600 的 keys/rev-<n>.key，不进 config.json、不进日志）；
#   3. SWE_AI_ALLOWED_HOSTS 要放行那个域名。
#
# 用法：
#   set -a; . ./env.spark.example; set +a
#   node packages/ai-service/server.mjs
#
# 然后在管理页填 Base URL / 模型 / Key，认证方式选 auto，保存 → 检查连接 → 生成测试。
# Key 只在保存那一次从浏览器提交，之后 API 只回 hasKey: true。

# --- 监听 ---------------------------------------------------------------
SWE_BIND=127.0.0.1
SWE_PORT=8080
SWE_STATIC_DIR=../packages/integrated-web/dist
SWE_DATA_DIR=/var/lib/swe-ai

# 对外 origin。反代部署时必填，否则登录 cookie 与 Origin 校验会按对端地址判断。
SWE_PUBLIC_ORIGIN=https://sky.example.edu.cn
SWE_TRUSTED_PROXY=127.0.0.1

# --- 上游白名单 ---------------------------------------------------------
# 换成厂商 OpenAI 兼容接口的真实域名（以厂商当前文档为准）。
# 只写域名，不要写路径；端口非 443 时写 host:port。
SWE_AI_ALLOWED_HOSTS=spark-api-open.xf-yun.com

# 若学校已经有自建的 /spark/v2 同源代理，更稳的做法是把 Base URL 指向它，
# 把厂商 Key 留在代理里，这里改成：
#   SWE_AI_ALLOWED_HOSTS=127.0.0.1:8102
#   authMode=none，且不存 Key —— 服务端就不需要接触厂商密钥了。

# --- 口令 ---------------------------------------------------------------
SWE_ACCESS_TOKENS_FILE=/etc/swe-ai/class.tokens
SWE_ADMIN_TOKENS_FILE=/etc/swe-ai/admin.tokens

# --- 其它 ---------------------------------------------------------------
SWE_REQUIRE_AUTH=1
SWE_STORE_BACKEND=auto
SWE_LOG_LEVEL=info

# 管理页里建议同时收紧的上限（保存时写入 config.json）：
#   maxOutputTokens   800        单次输出上界，控制单次开销
#   timeoutMs         180000     总超时（与前端 180 秒等待一致）
#   idleTimeoutMs     60000      正文停滞超时
#   connectTimeoutMs  10000      连接超时
#   globalInflight    4          全站并发
#   perIdentityInflight 1        单身份并发
#   dailyGlobal       400        全站每日次数上限
#   dailyPerIdentity  60         单身份每日次数上限
#   dayTz             Asia/Shanghai
